# Copy to .env for local development. Never commit the real .env.
# Semua variabel memakai prefix VISION_.

# local | staging | production
VISION_APP_ENV=local

# stub | onnx
# stub = deterministic placeholder predictor, only allowed outside production.
VISION_MODEL_BACKEND=stub

VISION_MODEL_DIR=models
VISION_COMMODITY_CODE=chili

# Model versions resolved from <model_dir>/<version>/manifest.json
VISION_DISEASE_MODEL_VERSION=disease-chili-v0.1.0
VISION_RIPENESS_MODEL_VERSION=ripeness-chili-v0.1.0

# Optional shadow model for staging evaluation (TQA 8.4). Leave empty to disable.
VISION_SHADOW_DISEASE_MODEL_VERSION=
VISION_SHADOW_RIPENESS_MODEL_VERSION=

# Hard limits enforced by this service. The public API enforces the stricter
# 2 MB / 1280 px rule from design.md 11.1 before forwarding.
VISION_MAX_UPLOAD_BYTES=8388608
VISION_MAX_IMAGE_PIXELS=40000000
VISION_MAX_IMAGE_SIDE=4096
VISION_MIN_IMAGE_SIDE=224

VISION_TOP_K=3
VISION_MAX_CONCURRENT_INFERENCE=4
VISION_INFERENCE_TIMEOUT_SECONDS=2.0

# Result status thresholds (design.md 11.2). Uncertain < confident is enforced.
VISION_CONFIDENT_THRESHOLD=0.75
VISION_UNCERTAIN_THRESHOLD=0.50

# Bearer token the Tanami backend must present on /v1/*. Empty disables the
# check (local only); mandatory in production.
VISION_SERVICE_TOKEN=

# Required to call /v1/models/reload. Leave empty to disable the admin API.
VISION_ADMIN_TOKEN=

VISION_LOG_LEVEL=INFO
VISION_LOG_JSON=true
