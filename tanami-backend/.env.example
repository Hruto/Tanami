# Copy to .env for local development. Never commit the real .env.
# Every variable uses the TANAMI_ prefix.

TANAMI_APP_ENV=local

# --- Database ---------------------------------------------------------------
# Async driver for the app; Alembic converts it to psycopg automatically.
TANAMI_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/tanami
TANAMI_DB_POOL_SIZE=10
TANAMI_DB_MAX_OVERFLOW=20
TANAMI_DB_ECHO=false

# --- Redis (refresh tokens, weather cache, rate limit, push cap) ------------
TANAMI_REDIS_URL=redis://127.0.0.1:6379/0

# --- Auth -------------------------------------------------------------------
# Minimum 32 characters. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
TANAMI_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
TANAMI_ACCESS_TOKEN_TTL_SECONDS=900
TANAMI_REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Vision service (tanami-vision) ----------------------------------------
TANAMI_VISION_BASE_URL=http://127.0.0.1:8001
TANAMI_VISION_SERVICE_TOKEN=
TANAMI_VISION_TIMEOUT_SECONDS=6.0
TANAMI_VISION_RETRIES=2

# --- Uploads ----------------------------------------------------------------
# design.md 10.6 / 11.1: client compresses to <= 2 MB and <= 1280 px.
TANAMI_MAX_SCAN_UPLOAD_BYTES=2097152
TANAMI_MAX_IMAGE_SIDE=1280
TANAMI_MAX_IMAGE_PIXELS=40000000

# --- Object storage ---------------------------------------------------------
# s3 | memory. Memory is for tests and local dry runs only.
TANAMI_STORAGE_BACKEND=memory
TANAMI_S3_ENDPOINT_URL=http://127.0.0.1:9000
TANAMI_S3_BUCKET=tanami
TANAMI_S3_REGION=auto
TANAMI_S3_ACCESS_KEY_ID=
TANAMI_S3_SECRET_ACCESS_KEY=
TANAMI_S3_PUBLIC_BASE_URL=
TANAMI_S3_PRESIGN_TTL_SECONDS=3600

# --- Weather ----------------------------------------------------------------
TANAMI_BMKG_BASE_URL=https://api.bmkg.go.id
TANAMI_WEATHER_CACHE_TTL_SECONDS=21600
TANAMI_WEATHER_TIMEOUT_SECONDS=5.0
# Spacing between BMKG calls in the refresh job (limit: 60 requests/minute/IP).
TANAMI_BMKG_MIN_INTERVAL_SECONDS=1.1

# --- Reminders --------------------------------------------------------------
TANAMI_QUIET_HOURS_START=21
TANAMI_QUIET_HOURS_END=5
TANAMI_MAX_PUSH_PER_DAY=3
TANAMI_SCAN_FOLLOWUP_DAYS=5
TANAMI_PLANT_STATUS_STALE_DAYS=14
TANAMI_FUNGAL_HISTORY_DAYS=30

# --- Rate limits (design 10.3) ----------------------------------------------
TANAMI_LOGIN_RATE_LIMIT_PER_MINUTE=5
TANAMI_REGISTER_RATE_LIMIT_PER_MINUTE=20
TANAMI_SCAN_RATE_LIMIT_PER_MINUTE=20
TANAMI_GLOBAL_RATE_LIMIT_PER_MINUTE=120
# true ONLY behind a reverse proxy that overwrites X-Forwarded-For.
TANAMI_TRUST_FORWARDED_FOR=false

# --- Forum and accounts ----------------------------------------------------
TANAMI_FORUM_REPORTS_TO_HIDE=3
TANAMI_ACCOUNT_PURGE_DAYS=30
# Comma-separated emails/phones promoted to admin when they register.
TANAMI_BOOTSTRAP_ADMINS=

# --- Jobs -------------------------------------------------------------------
# Keep false on more than one replica: the scheduler is single-instance.
TANAMI_JOBS_ENABLED=false
TANAMI_TIMEZONE=Asia/Jakarta

# --- Misc -------------------------------------------------------------------
TANAMI_CORS_ORIGINS=
TANAMI_LOG_LEVEL=INFO
TANAMI_LOG_JSON=true
TANAMI_SEED_ON_STARTUP=true

# --- Push (FCM HTTP v1; the legacy server key API no longer exists) ----------
# Path to the Firebase service-account JSON, or the JSON itself. Empty = pushes
# are only logged (local development).
TANAMI_FCM_CREDENTIALS_FILE=
TANAMI_FCM_CREDENTIALS_JSON=
